# Copy this file to .env and replace the examples locally.
# Never commit .env, credentials, certificates, or private fiscal files.

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/ikontrol2/'

database.default.hostname = localhost
database.default.database = ikontrol_example
database.default.username = ikontrol_example_user
database.default.password = change-locally
database.default.DBDriver = MySQLi
database.default.DBPrefix = ikontrol_
database.default.port = 3306

# TimbradorXpress is managed by iKontrol. Keep real keys only in the local .env.
TIMBRADORXPRESS_ENVIRONMENT = sandbox
TIMBRADORXPRESS_APIKEY_SANDBOX =
TIMBRADORXPRESS_APIKEY_PRODUCTION =
TIMBRADORXPRESS_BASE_URL_SANDBOX = https://dev.timbradorxpress.mx/api/rest/servicio/
TIMBRADORXPRESS_BASE_URL_PRODUCTION = https://app.timbradorxpress.mx/api/rest/servicio/
TIMBRADORXPRESS_CONNECT_TIMEOUT = 10
TIMBRADORXPRESS_REQUEST_TIMEOUT = 60
TIMBRADORXPRESS_PRODUCTION_ENABLED = false

# Separate external key for encrypted PAC contingency payloads.
fiscal.pacEncryptionKey =
# 64 hexadecimal characters generated from random_bytes(32). Keep only in local .env.
fiscal.csdEncryptionKey =

# Increment 0: the fiscal module must remain disabled and offline.
fiscal.enabled = false
fiscal.previewMode = false
fiscal.stampingEnabled = false
fiscal.runtimeMode = integration
fiscal.environment = local
fiscal.allowRealPac = false
fiscal.maxIssueAgeHours = 72
fiscal.allowFutureIssueDate = false
fiscal.allowExternalPdf = false
fiscal.privateStoragePath = 'writable/fiscal-private'
fiscal.pacAdapter = fake
fiscal.fakePacScenario = success
fiscal.stampingSendingStaleMinutes = 5

# Separate provider-tools service: stamped XML in, PDF representation out.
fiscal.pdf.provider = fake
fiscal.pdf.allowExternalPdf = false
fiscal.pdf.defaultTemplateIncome =
fiscal.pdf.defaultTemplateExpense =
fiscal.pdf.defaultTemplatePayment =
fiscal.pdf.defaultTemplateTransfer =
fiscal.pdf.defaultTemplatePayroll =
MULTIPAC_TOOLS_ENABLED = false
MULTIPAC_TOOLS_WSDL =
MULTIPAC_TOOLS_USER =
MULTIPAC_TOOLS_PASSWORD =
MULTIPAC_TOOLS_ALLOW_INSECURE_HTTP = false
MULTIPAC_TOOLS_ALLOWED_HOSTS =
MULTIPAC_TOOLS_CONNECT_TIMEOUT = 30
MULTIPAC_TOOLS_REQUEST_TIMEOUT = 60
# FC2 legacy source (use a dedicated MySQL user granted SELECT only)
FC2_DB_HOST=
FC2_DB_PORT=3306
FC2_DB_DATABASE=
FC2_DB_USERNAME=
FC2_DB_PASSWORD=
FC2_DB_CHARSET=utf8mb4

# External fiscal-stamp administration (set a random value of at least 32 characters only on the server).
TIMBRES_ADMIN_SECRET=
